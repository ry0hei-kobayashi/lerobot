# cp env.sh.example env.sh して編集する (env.sh は git-ignore 済み)
# ジョブスクリプトと submit.sh が source する

# ABCI グループ名 (qsub -P に使う。例: gaa50000)
export ABCI_GROUP=gaa00000

# Hugging Face トークン (pi0 の paligemma ダウンロードに必要。ライセンス承諾も済ませておく)
export HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# (任意) wandb
# export WANDB_API_KEY=xxxxxxxx
# export WANDB_ENABLE=true

# HF キャッシュ。ホームの quota を避けるためグループ領域を推奨
export HF_HOME=/groups/${ABCI_GROUP}/${USER}/hf_cache

# SIF の場所 (ローカルで build して scp する場合はここに置く)
export LEROBOT_SIF=/groups/${ABCI_GROUP}/${USER}/sif/pi0.sif

# 学習パラメータ (ジョブスクリプトで参照)
export DATASET=danaaubakirova/koch_test
export PRETRAINED=lerobot/pi0_base
export JOB_NAME=pi0_finetune
export BATCH_SIZE=16
export STEPS=30000
export SAVE_FREQ=5000
