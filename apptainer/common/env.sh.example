# cp env.sh.example env.sh して編集する (env.sh は git-ignore 済み)。
# apptainer/{train,eval,deploy}/*.sh, common/submit.sh, image/build_on_abci.sh,
# docker/{train,eval,deploy}/*.sh が source する。ABCI / 研究室 Slurm / ローカル docker で
# 同じファイルを使う (該当しない項目は無視される)。
#
# 値は "${VAR:-default}" 形式なので、コマンドラインの VAR=... 指定が優先される:
#   BATCH_SIZE=8 STEPS=20 ./train_pi05.sh
# ここに無い項目の最終デフォルトは common/lerobot_args.sh にある。

# ---- 認証 ----------------------------------------------------------------------
# Hugging Face トークン。pi05 の tokenizer (google/paligemma-3b-pt-224) は gated なので
# HF 上でライセンスを承諾しておく
export HF_TOKEN="${HF_TOKEN:-hf_xxxxxxxxxxxxxxxxxxxxxxxx}"
# (任意) wandb
# export WANDB_API_KEY="${WANDB_API_KEY:-xxxxxxxx}"
# export WANDB_ENABLE="${WANDB_ENABLE:-true}"

# ---- ABCI 固有 (研究室 Slurm / ローカルでは無視) ----------------------------------
export ABCI_GROUP="${ABCI_GROUP:-gaa00000}"          # qsub -P
if [ -d "/groups/$ABCI_GROUP" ]; then
    # ABCI: ホームの quota を避けてグループ領域に置く
    export HF_HOME="${HF_HOME:-/groups/$ABCI_GROUP/$USER/hf_cache}"
    export LEROBOT_SIF="${LEROBOT_SIF:-/groups/$ABCI_GROUP/$USER/sif/pi05.sif}"
else
    # 研究室 Slurm / ローカル: HF_HOME は ~/.cache/huggingface、SIF は apptainer/image/pi05.sif
    export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
    # export LEROBOT_SIF="${LEROBOT_SIF:-/path/to/pi05.sif}"
fi

# ---- 学習 (common/lerobot_args.sh: lerobot_train_args) ------------------------------
export POLICY_TYPE="${POLICY_TYPE:-pi05}"             # pi0 に戻す場合: POLICY_TYPE=pi0 PRETRAINED=lerobot/pi0_base
export PRETRAINED="${PRETRAINED:-lerobot/pi05_base}"  # lerobot/pi05_libero_base も可
export DATASET="${DATASET:-lerobot/aloha_sim_transfer_cube_human}"   # deploy の AlohaTransferCube-v0 と対
export JOB_NAME="${JOB_NAME:-pi05_aloha_sim}"
export BATCH_SIZE="${BATCH_SIZE:-32}"      # H200 141GB: 32-64 / A100 80GB: 16-32 / RTX A6000 48GB: 4-8 (+TRAIN_EXPERT_ONLY=true)
export STEPS="${STEPS:-20000}"
export SAVE_FREQ="${SAVE_FREQ:-5000}"
export NUM_WORKERS="${NUM_WORKERS:-8}"
export N_ACTION_STEPS="${N_ACTION_STEPS:-10}"   # 50Hz aloha で 10 step (0.2s) ごとに再推論 (openpi examples/aloha_sim と同じ)
export EMPTY_CAMERAS="${EMPTY_CAMERAS:-0}"      # aloha sim はカメラ 1 台 (top)。空スロットの追加は不要
export TRAIN_EXPERT_ONLY="${TRAIN_EXPERT_ONLY:-false}"      # true: VLM 凍結・action expert のみ学習 (省メモリ)
export FREEZE_VISION_ENCODER="${FREEZE_VISION_ENCODER:-false}"
export COMPILE_MODEL="${COMPILE_MODEL:-true}"   # スモークテストでは false (torch.compile の warmup が長い)
# q01/q99 統計が無い dataset の場合 (ValueError: QUANTILES normalization mode requires q01 and q99):
# export NORM_MAPPING='{"ACTION":"MEAN_STD","STATE":"MEAN_STD","VISUAL":"IDENTITY"}'
# 追加引数 (空白区切り): export EXTRA_TRAIN_ARGS="--policy.rtc_training_max_delay=10"

# ---- 評価 (lerobot-eval; eval/eval_pi05.sh) ---------------------------------------
# export CKPT="${CKPT:-outputs/train/$JOB_NAME/checkpoints/last/pretrained_model}"
export EVAL_ENV="${EVAL_ENV:-aloha}"          # aloha / libero
# export EVAL_TASK=AlohaInsertion-v0          # 未指定なら aloha: AlohaTransferCube-v0 / libero: libero_object
export EVAL_EPISODES="${EVAL_EPISODES:-50}"
export EVAL_BATCH="${EVAL_BATCH:-10}"         # 並列 env 数
export EVAL_ASYNC="${EVAL_ASYNC:-false}"      # true にすると AsyncVectorEnv。aloha は worker で gym_aloha が見つからず落ちる (lerobot 側の問題) ので false

# ---- deploy (gym-aloha で rollout して動画保存; deploy/deploy_pi05_aloha.sh) ---------
export DEPLOY_TASK="${DEPLOY_TASK:-AlohaTransferCube-v0}"   # DATASET と対にする (insertion なら AlohaInsertion-v0)
export DEPLOY_EPISODES="${DEPLOY_EPISODES:-10}"   # lerobot-eval が動画保存するのは最大 10 episode
