# LeRobot pi0 fine-tune / eval container
#
# ローカル (apptainer):  cd apptainer && apptainer build --fakeroot pi0.sif pi0.def
# ABCI    (singularitypro):  cd apptainer && singularity build --fakeroot pi0.sif pi0.def
#
# 中身は docker/Dockerfile.internal (HF 公式 GPU イメージ) と同じ構成:
#   CUDA 12.8 / Ubuntu 24.04 / Python 3.12 / uv / uv.lock で固定した依存
#
# リポジトリは /opt/lerobot に editable install される。
# 実行時に手元のリポジトリを --bind <repo>:/opt/lerobot で上書きすると
# SIF を作り直さずにコード変更が反映される (venv は /opt/venv なので影響なし)。

Bootstrap: docker
From: nvidia/cuda:12.8.1-base-ubuntu24.04

%labels
    Author          Ryohei Kobayashi
    Description     LeRobot pi0 train/eval (CUDA 12.8, Python 3.12, uv)

%files
    ../pyproject.toml   /opt/lerobot/pyproject.toml
    ../uv.lock          /opt/lerobot/uv.lock
    ../setup.py         /opt/lerobot/setup.py
    ../README.md        /opt/lerobot/README.md
    ../MANIFEST.in      /opt/lerobot/MANIFEST.in
    ../src              /opt/lerobot/src

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    export PYTHON_VERSION=3.12

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential git git-lfs curl wget ca-certificates \
        vim less htop tmux tree \
        libglib2.0-0 libgl1 libegl1 ffmpeg \
        libusb-1.0-0-dev speech-dispatcher libgeos-dev portaudio19-dev \
        cmake pkg-config ninja-build \
        python${PYTHON_VERSION} python${PYTHON_VERSION}-venv python${PYTHON_VERSION}-dev \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # uv
    curl -LsSf https://astral.sh/uv/install.sh | sh
    mv /root/.local/bin/uv /usr/local/bin/uv

    # venv はリポジトリの外 (/opt/venv) に置く。
    # 実行時に /opt/lerobot をホストのリポジトリで bind しても venv が隠れないようにするため。
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export UV_NO_CACHE=1
    cd /opt/lerobot
    uv venv --python python${PYTHON_VERSION} /opt/venv

    # 必要な extra だけ入れる (全部入りにしたければ --extra all)
    #   pi       : pi0 / pi05 (transformers, scipy)
    #   training : datasets, wandb, accelerate, torchcodec
    #   libero   : LIBERO シミュレーション eval
    #   pusht    : PushT シミュレーション eval
    uv sync --locked \
        --extra pi --extra training --extra libero --extra pusht

    # Dockerfile.internal と同じ workaround (triton の ptxas に実行権限が無い)
    chmod +x /opt/venv/lib/python${PYTHON_VERSION}/site-packages/triton/backends/nvidia/bin/ptxas || true

    # 実行ユーザは root ではないので読めるようにしておく
    chmod -R a+rX /opt/lerobot /opt/venv

    git config --system --add safe.directory '*'

%environment
    export PATH="/opt/venv/bin:$PATH"
    export VIRTUAL_ENV=/opt/venv
    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export MUJOCO_GL=egl
    export TOKENIZERS_PARALLELISM=false
    export PYTHONUNBUFFERED=1
    # HF_HOME 等は実行側 (ジョブスクリプト) で --env / SINGULARITYENV_ を使って渡す

%runscript
    # `apptainer run pi0.sif <cmd...>` でそのまま venv 内のコマンドを実行する
    # 例: apptainer run --nv pi0.sif lerobot-train --policy.type=pi0 ...
    if [ $# -eq 0 ]; then
        exec /bin/bash
    fi
    exec "$@"

%test
    python -c "import lerobot, torch; print('lerobot', lerobot.__version__, 'torch', torch.__version__)"
    which lerobot-train lerobot-eval
